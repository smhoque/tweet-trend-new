pipeline {

    /*
     * ============================================================
     * AGENT
     * ============================================================
     */
    agent {
        node {
            label "maven"
        }
    }


    /*
     * ============================================================
     * ENVIRONMENT
     * ============================================================
     */
    environment {

        // Maven
        PATH = "/opt/apache-maven-3.9.16/bin:$PATH"

        // JFrog Artifactory
        REGISTRY = "https://trialr0z87d.jfrog.io"

        // Docker image
        IMAGE_NAME = "trialr0z87d.jfrog.io/lib-docker-local/ttrend"
        IMAGE_VERSION = "2.1.2"
    }


    /*
     * ============================================================
     * STAGES
     * ============================================================
     */
    stages {


        /*
         * --------------------------------------------------------
         * BUILD
         * --------------------------------------------------------
         */
        stage("Build") {

            steps {

                echo "----------- Build Started ----------"

                sh "mvn clean deploy -Dmaven.test.skip=true"

                echo "----------- Build Completed ----------"
            }
        }


        /*
         * --------------------------------------------------------
         * UNIT TEST
         * --------------------------------------------------------
         */
        stage("Test") {

            steps {

                echo "----------- Unit Test Started ----------"

                sh "mvn surefire-report:report"

                echo "----------- Unit Test Completed ----------"
            }
        }


        /*
         * --------------------------------------------------------
         * SONARQUBE ANALYSIS
         * --------------------------------------------------------
         */
        stage("SonarQube Analysis") {

            environment {
                scannerHome = tool "valaxy-sonar-scanner"
            }

            steps {

                echo "----------- SonarQube Analysis Started ----------"

                withSonarQubeEnv("valaxy-sonarqube-server") {

                    sh "${scannerHome}/bin/sonar-scanner"
                }

                echo "----------- SonarQube Analysis Completed ----------"
            }
        }


        /*
         * --------------------------------------------------------
         * QUALITY GATE
         * --------------------------------------------------------
         *
         * Uncomment this stage if you want Jenkins to wait for
         * SonarQube and stop the pipeline if the quality gate fails.
         *
         */
        /*
        stage("Quality Gate") {

            steps {

                script {

                    timeout(time: 1, unit: "HOURS") {

                        def qg = waitForQualityGate()

                        if (qg.status != "OK") {

                            error "Pipeline aborted due to quality gate failure: ${qg.status}"
                        }
                    }
                }
            }
        }
        */


        /*
         * --------------------------------------------------------
         * JAR PUBLISH
         * --------------------------------------------------------
         */
        stage("Jar Publish") {

            steps {

                script {

                    echo "<--------------- Jar Publish Started --------------->"

                    def server = Artifactory.newServer(
                        url: "${env.REGISTRY}/artifactory",
                        credentialsId: "artifactory_token"
                    )

                    def properties =
                        "buildid=${env.BUILD_ID},commitid=${GIT_COMMIT}"

                    def uploadSpec = """{
                        "files": [
                            {
                                "pattern": "jarstaging/(*)",
                                "target": "01-libs-release-local/{1}",
                                "flat": "false",
                                "props": "${properties}",
                                "exclusions": [
                                    "*.sha1",
                                    "*.md5"
                                ]
                            }
                        ]
                    }"""

                    def buildInfo = server.upload(uploadSpec)

                    buildInfo.env.collect()

                    server.publishBuildInfo(buildInfo)

                    echo "<--------------- Jar Publish Completed --------------->"
                }
            }
        }


        /*
         * --------------------------------------------------------
         * DOCKER BUILD
         * --------------------------------------------------------
         */
        stage("Docker Build") {

            steps {

                script {

                    echo "<--------------- Docker Build Started --------------->"

                    app = docker.build(
                        "${env.IMAGE_NAME}:${env.IMAGE_VERSION}"
                    )

                    echo "<--------------- Docker Build Completed --------------->"
                }
            }
        }


        /*
         * --------------------------------------------------------
         * DOCKER PUBLISH
         * --------------------------------------------------------
         */
        stage("Docker Publish") {

            steps {

                script {

                    echo "<--------------- Docker Publish Started --------------->"

                    docker.withRegistry(
                        env.REGISTRY,
                        "artifactory_token"
                    ) {

                        app.push()
                    }

                    echo "<--------------- Docker Publish Completed --------------->"
                }
            }
        }
    }
}
