pipeline {
    agent {
        node {
            label "maven"
        }
    }

    environment {
        MAVEN_HOME = "/opt/apache-maven-3.9.16"
        PATH = "${env.MAVEN_HOME}/bin:$PATH"

        REGISTRY = "trialu7cpje.jfrog.io"
        IMAGE_NAME = "${REGISTRY}/valaxy-docker-local/ttrend"
        VERSION = "2.1.2"
    }

    stages {

        stage("Checkout") {
            steps {
                checkout scm
            }
        }

        stage("Build") {
            steps {
                echo "----------- BUILD STARTED ----------"
                sh 'mvn clean package -Dmaven.test.skip=true'
                echo "----------- BUILD COMPLETED ----------"
            }
        }

        stage("Test") {
            steps {
                echo "----------- TEST STARTED ----------"
                sh 'mvn surefire-report:report'
                echo "----------- TEST COMPLETED ----------"
            }
        }

        stage("SonarQube Analysis") {
            environment {
                scannerHome = tool 'valaxy-sonar-scanner'
            }
            steps {
                withSonarQubeEnv('valaxy-sonarqube-server') {
                    sh "${scannerHome}/bin/sonar-scanner"
                }
            }
        }

        /*
        stage("Quality Gate") {
            steps {
                script {
                    timeout(time: 1, unit: 'HOURS') {
                        def qg = waitForQualityGate()
                        if (qg.status != 'OK') {
                            error "Pipeline failed due to Quality Gate: ${qg.status}"
                        }
                    }
                }
            }
        }
        */

        stage("Artifactory Upload") {
            steps {
                script {
                    echo "----------- ARTIFACT UPLOAD STARTED ----------"

                    def server = Artifactory.newServer(
                        url: "https://${env.REGISTRY}/artifactory",
                        credentialsId: "artifactory_token"
                    )

                    def uploadSpec = """
                    {
                        "files": [
                            {
                                "pattern": "target/*.jar",
                                "target": "maven-libs-release-local/",
                                "flat": true
                            }
                        ]
                    }
                    """

                    def buildInfo = server.upload(uploadSpec)
                    server.publishBuildInfo(buildInfo)

                    echo "----------- ARTIFACT UPLOAD COMPLETED ----------"
                }
            }
        }

        stage("Docker Build") {
            steps {
                script {
                    echo "----------- DOCKER BUILD STARTED ----------"

                    app = docker.build("${env.IMAGE_NAME}:${env.VERSION}")

                    echo "----------- DOCKER BUILD COMPLETED ----------"
                }
            }
        }

        stage("Docker Push") {
            steps {
                script {
                    echo "----------- DOCKER PUSH STARTED ----------"

                    docker.withRegistry("https://${env.REGISTRY}", "artifactory_token") {
                        app.push("${env.VERSION}")
                    }

                    echo "----------- DOCKER PUSH COMPLETED ----------"
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline SUCCESS 🎉"
        }
        failure {
            echo "Pipeline FAILED ❌"
        }
    }
}